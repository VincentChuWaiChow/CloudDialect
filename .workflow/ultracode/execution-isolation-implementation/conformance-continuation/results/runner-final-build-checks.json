[
  {
    "name": "runner-controls-refactor",
    "command": [
      "rtk",
      "proxy",
      "cargo",
      "test",
      "--manifest-path",
      "crates/clouddialect-contracts/Cargo.toml",
      "--frozen",
      "--test",
      "conformance_controls"
    ],
    "exit_code": 0
  },
  {
    "name": "runner-check-final",
    "command": [
      "rtk",
      "proxy",
      "cargo",
      "check",
      "--manifest-path",
      "crates/clouddialect-contracts/Cargo.toml",
      "--frozen",
      "--all-targets"
    ],
    "exit_code": 0
  },
  {
    "name": "runner-clippy-final",
    "command": [
      "rtk",
      "proxy",
      "cargo",
      "clippy",
      "--manifest-path",
      "crates/clouddialect-contracts/Cargo.toml",
      "--frozen",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "runner-fmt-final",
    "command": [
      "rtk",
      "proxy",
      "cargo",
      "fmt",
      "--manifest-path",
      "crates/clouddialect-contracts/Cargo.toml",
      "--check"
    ],
    "exit_code": 0
  }
]
