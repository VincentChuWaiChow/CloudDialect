{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clouddialect.io/evidence-record/1.0.0/schema.json",
  "type": "object",
  "required": [
    "id",
    "format_version",
    "claim",
    "classification"
  ],
  "properties": {
    "required_extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9-]+$",
        "not": {"pattern": "\\s"}
      }
    },
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4, hyphenated lowercase.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "format_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "claim": {
      "type": "string"
    },
    "classification": {
      "type": "string",
      "enum": [
        "observed",
        "inferred",
        "unknown"
      ]
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assumption_id",
          "description",
          "reason"
        ],
        "properties": {
          "assumption_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "classification": {
        "const": "observed"
      }
    }
  },
  "then": {
    "required": [
      "provenance"
    ],
    "properties": {
      "provenance": {
        "type": "object",
        "required": [
          "source_artifact_identity",
          "analysis_tool_identity"
        ],
        "properties": {
          "source_artifact_identity": {
            "type": "string"
          },
          "analysis_tool_identity": {
            "type": "string"
          }
        }
      }
    }
  },
  "else": {
    "if": {
      "properties": {
        "classification": {
          "const": "inferred"
        }
      }
    },
    "then": {
      "required": [
        "reasoning_chain"
      ],
      "properties": {
        "reasoning_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "else": {
      "required": [
        "unresolved_assumptions"
      ],
      "properties": {
        "unresolved_assumptions": {
          "minItems": 1
        }
      }
    }
  },
  "patternProperties": {
    "^[a-zA-Z][a-zA-Z0-9\\-]+:": {}
  },
  "unevaluatedProperties": false
}
