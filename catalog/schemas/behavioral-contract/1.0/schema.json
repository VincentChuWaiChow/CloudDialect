{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.clouddialect.io/behavioral-contract/1.0.0/schema.json",
  "type": "object",
  "required": [
    "id",
    "format_version",
    "operation_identity",
    "inputs",
    "outputs",
    "side_effects",
    "resource_dependencies",
    "obligations"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4, hyphenated lowercase. Unique within the pack.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "format_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Document-format version (SemVer 2.0.0). Distinct from pack version and JSON Schema dialect version.",
      "not": {
        "pattern": "\\s"
      }
    },
    "operation_identity": {
      "type": "object",
      "required": [
        "call_site"
      ],
      "properties": {
        "call_site": {
          "type": "string",
          "description": "Fully qualified identifier of the operation entry point."
        },
        "wrapper_chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered list of wrappers in the call chain up to the operation boundary. Required to be non-empty when a wrapper chain exists.",
          "minItems": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "description": "JSON Schema fragment describing the operation's input structure."
    },
    "outputs": {
      "type": "object",
      "description": "JSON Schema fragment describing the operation's output structure."
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string",
            "description": "Reference to an evidence record id."
          }
        }
      },
      "description": "Externally visible side effects."
    },
    "resource_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "identity",
          "permissions",
          "configuration"
        ],
        "properties": {
          "identity": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "configuration": {
            "type": "object"
          },
          "known_behavior": {
            "type": "object",
            "properties": {
              "ordering": {
                "type": "string",
                "minLength": 1
              },
              "consistency": {
                "type": "string",
                "minLength": 1
              },
              "retry": {
                "type": "string",
                "minLength": 1
              },
              "failure": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "unresolved_assumptions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/resource_unresolved_assumption"
            }
          }
        },
        "allOf": [
          {
            "anyOf": [
              {
                "required": ["known_behavior"],
                "properties": {"known_behavior": {"required": ["ordering"]}}
              },
              {
                "required": ["unresolved_assumptions"],
                "properties": {"unresolved_assumptions": {"contains": {"required": ["behavior"], "properties": {"behavior": {"const": "ordering"}}}}}
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": ["known_behavior"],
                "properties": {"known_behavior": {"required": ["consistency"]}}
              },
              {
                "required": ["unresolved_assumptions"],
                "properties": {"unresolved_assumptions": {"contains": {"required": ["behavior"], "properties": {"behavior": {"const": "consistency"}}}}}
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": ["known_behavior"],
                "properties": {"known_behavior": {"required": ["retry"]}}
              },
              {
                "required": ["unresolved_assumptions"],
                "properties": {"unresolved_assumptions": {"contains": {"required": ["behavior"], "properties": {"behavior": {"const": "retry"}}}}}
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": ["known_behavior"],
                "properties": {"known_behavior": {"required": ["failure"]}}
              },
              {
                "required": ["unresolved_assumptions"],
                "properties": {"unresolved_assumptions": {"contains": {"required": ["behavior"], "properties": {"behavior": {"const": "failure"}}}}}
              }
            ]
          }
        ]
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "behavioral_fidelity"
        ],
        "oneOf": [
          {
            "required": [
              "evidence_refs"
            ],
            "properties": {
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "not": {
              "required": [
                "unresolved_assumption"
              ]
            }
          },
          {
            "required": [
              "unresolved_assumption"
            ],
            "properties": {
              "unresolved_assumption": {
                "$ref": "#/$defs/unresolved_assumption"
              }
            },
            "not": {
              "required": [
                "evidence_refs"
              ]
            }
          }
        ],
        "properties": {
          "obligation_id": {
            "type": "string"
          },
          "behavioral_fidelity": {
            "type": "string",
            "enum": [
              "equivalent-within-contract",
              "adaptation-required",
              "architectural-change-required",
              "unsupported",
              "unknown"
            ]
          }
        }
      }
    },
    "behavioral_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "note_type",
          "description",
          "evidence_ref"
        ],
        "properties": {
          "note_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    }
  },
  "patternProperties": {
    "^[a-zA-Z][a-zA-Z0-9\\-]+:": {}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "resource_unresolved_assumption": {
      "$ref": "#/$defs/unresolved_assumption",
      "required": ["behavior"],
      "properties": {
        "behavior": {
          "type": "string",
          "enum": ["ordering", "consistency", "retry", "failure"]
        },
        "assumption_id": {"minLength": 1},
        "description": {"minLength": 1},
        "reason": {"minLength": 1}
      }
    },
    "unresolved_assumption": {
      "type": "object",
      "required": [
        "assumption_id",
        "description",
        "reason"
      ],
      "properties": {
        "assumption_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
